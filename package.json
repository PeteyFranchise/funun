    "@types/jest": "^30.0.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.0",
    "eslint": "9.39.3",
    "eslint-config-next": "15.5.24",
    "jest": "30.5.1",
    "postcss": "^8.5.28",
    "supabase": "2.116.0",
    "tailwindcss": "^3.4.0",
    "ts-jest": "^29.4.11",
    "tsx": "^4.23.11",
    "typescript": "^5.5.0"
