    "@react-pdf/renderer": "^4.5.1",
    "@sentry/nextjs": "^10.70.0",
    "@stripe/stripe-js": "^4.0.0",
    "@supabase/auth-helpers-nextjs": "^0.10.0",
    "@supabase/supabase-js": "^2.45.0",
    "archiver": "^8.0.0",
    "dompurify": "^3.4.15",
    "mermaid": "^11.17.2",
    "next": "15.5.24",
    "node-id3": "^0.2.9",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "resend": "^4.0.0",
    "stripe": "^17.7.0",
    "svix": "^1.96.1",
    "tus-js-client": "^4.3.1",
    "zod": "^3.23.0"
