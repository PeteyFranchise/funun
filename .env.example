# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Anthropic — server-side only, never exposed to client
ANTHROPIC_API_KEY=your_anthropic_api_key

# OpenAI — server-side only. Lyric Lift uses high-accuracy transcription,
# timestamp alignment, and structured song-section detection.
OPENAI_API_KEY=your_openai_api_key
# Optional pinned overrides; defaults shown.
OPENAI_TRANSCRIPTION_MODEL=gpt-transcribe
OPENAI_LYRIC_ALIGNMENT_MODEL=whisper-1
OPENAI_LYRIC_STRUCTURE_MODEL=gpt-5.6-sol

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PRO_MONTHLY=price_...
STRIPE_PRICE_PRO_YEARLY=price_...
STRIPE_PRICE_STUDIO_MONTHLY=price_...
STRIPE_PRICE_STUDIO_YEARLY=price_...
STRIPE_PRICE_FOUNDING=price_...

# Resend
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=pete@funun.studio
# Monitored mailbox used as sender AND reply-to for Funūn's split-sheet
# signature invites (17-10). Collaborator replies land here, so it must be a
# real, monitored inbox on a domain verified with Resend — not a no-reply.
ESIGN_FROM_EMAIL=esign@funun.studio
# DocuSeal e-signature provider (Phase 17). Server-only — exposing either
# value to the client would let anyone mint or forge envelopes.
# API token: DocuSeal dashboard -> API -> X-Auth-Token
DOCUSEAL_API_KEY=
# Webhook signing secret (whsec_-prefixed, used as-is — do not strip the
# prefix or base64-decode it). DocuSeal dashboard -> Webhooks
DOCUSEAL_WEBHOOK_SECRET=

# DDEX — sender Party ID for metadata exports; falls back to a placeholder if unset
DDEX_DPID=

# App
# Local dev: http://localhost:3000  ·  Production: https://funun.studio
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Set to "true" only for demo mode (hides the real backend); leave unset/false in prod
NEXT_PUBLIC_VAULT_DEMO=

# Song Passport Phase 37.3 rollout — server-side only and disabled by default.
# Global enablement exposes the feature to authorized work members. Pilot
# enablement consults server-owned account/work cohort rows instead.
SONG_PASSPORT_ENABLED=false
SONG_PASSPORT_PILOT_ENABLED=false
# Emergency stop wins over both global and pilot enablement.
SONG_PASSPORT_KILL_SWITCH=false

# Cloudflare Turnstile (Phase 27, D-12) — protects the /signup denied-artist
# waitlist form (POST /api/waitlist) only. Dashboard -> Turnstile -> Add widget.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Secret key — server-only, must NEVER carry a NEXT_PUBLIC_ prefix or be
# exposed to the client. Read inside lib/security/turnstile.ts only.
TURNSTILE_SECRET=

# Optional — set to "true" in Vercel to expose /profile-preview (the auth-free
# artist Settings mockup) in production for a review pass, then unset it.
# Always available in local development regardless of this value.
ENABLE_UI_PREVIEW=
